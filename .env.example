# ---------------------------------------------------------------
# Pick ONE provider. If LLM_PROVIDER is empty, the first provider
# with a key set is used (anthropic -> gemini -> openai-compatible).
# All keys are read only on the server (route handlers).
# ---------------------------------------------------------------
LLM_PROVIDER=            # anthropic | gemini | openai | mock

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Together,
# or a local Ollama / LM Studio server for open-source models.
#   Groq:        https://api.groq.com/openai/v1          model e.g. llama-3.3-70b-versatile
#   OpenRouter:  https://openrouter.ai/api/v1            model e.g. meta-llama/llama-3.3-70b-instruct
#   Ollama:      http://localhost:11434/v1               model e.g. llama3.1 (key can be anything)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
